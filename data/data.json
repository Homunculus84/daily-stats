  "quests": [
    {
      "id": "trial-of-the-missing-sock",
      "title": "The Trial of the Missing Sock",
      "description": "Search the laundry realm for its vanished twin before the dryer claims another innocent"
    },
    {
      "id": "overflowing-inbox-dungeon",
      "title": "The Overflowing Inbox Dungeon",
      "description": "Battle unread messages, defeat newsletter goblins, and recover the sacred scroll of zero notifications"
    },
    {
      "id": "curse-of-the-low-battery",
      "title": "The Curse of the Low Battery",
      "description": "Find a charging shrine before your enchanted rectangle reaches the dreaded one percent"
    },
    {
      "id": "the-grocery-gauntlet",
      "title": "The Grocery Gauntlet",
      "description": "Navigate crowded aisles, fight rogue shopping carts, and secure the just enough loot to survive until tomorrow"
    },
    {
      "id": "siege-of-the-jar-lid",
      "title": "The Siege of the Jar Lid",
      "description": "Summon legendary strength to conquer the stubborn lid guarding your promised midnight snack"
    },
    {
      "id": "the-forgotten-password-crypt",
      "title": "The Forgotten Password Crypt",
      "description": "Descend through dozens of security levels, recover the ancient confirmation codes, and reclaim your lost account"
    },
    {
      "id": "the-vanishing-parking-spot",
      "title": "The Vanishing Parking Spot",
      "description": "Wander the realm, outwit rival chariots, and claim the blessed parking spot before the time runs out"
    },
    {
      "id": "the-laundry-mountain",
      "title": "Ascent to Laundry Mountain",
      "description": "Climb the textile peak, defeat dirty beasts, and restore order to the wardrobe"
    },
    {
      "id": "the-coffee-of-resurrection",
      "title": "The Coffee of Resurrection",
      "description": "Brew the sacred potion before consciousness fades and productivity becomes permanently unavailable"
    },
    {
      "id": "the-dungeon-of-forgotten-leftovers",
      "title": "The Dungeon of Forgotten Leftovers",
      "description": "Investigate suspicious leftovers and identify which container holds treasure or harbors a hungry mimic"
    },
    {
      "id": "the-tupperware-vault",
      "title": "The Tupperware Vault",
      "description": "Match mysterious containers with their lids before the cabinet comes alive"
    },
    {
      "id": "the-lost-keyside-legend",
      "title": "Find the Forgotten Keys",
      "description": "Retrace yesterday's footsteps and interrogate every pocket until the legendary keys reveal themselves"
    },
    {
      "id": "the-mirror-of-judgment",
      "title": "The Mirror of Judgment",
      "description": "Face your morning reflection and survive its merciless critical hit before breakfast"
    },
    {
      "id": "the-tabs-of-doom",
      "title": "The Tabs of Doom",
      "description": "Close the ancient tabs one by one, lest their combined memory usage destroy the realm"
    },
    {
      "id": "the-curse-of-the-empty-roll",
      "title": "The Curse of the Empty Roll",
      "description": "Face the empty roll and accept its ancient truth: toilet paper does not respawn by itself"
    },
    {
      "id": "the-early-awakening",
      "title": "The Early Awakening",
      "description": "Survive the first hour after the alarm and reach your guild without aggroing the mobs on the way"
    },
    {
      "id": "the-boss-chamber",
      "title": "The Boss Chamber",
      "description": "Enter the office boss's chamber, survive the critical questions, and emerge with your dignity intact"
    },
    {
      "id": "the-council-of-endless-meetings",
      "title": "The Council of Endless Meetings",
      "description": "Survive the gathering of the council, where every agenda summons another meeting before you can escape"
    },
    {
      "id": "the-trial-of-the-diet",
      "title": "The Trial of the Snacks",
      "description": "Resist the forbidden snacks, ignore their seductive powers, and survive another day without depleting the rations"
    },
    {
      "id": "the-tax-collector",
      "title": "The Tax Collector",
      "description": "Gather your gold, decipher the ancient scrolls, and appease the realm before the deadline arrives"
    },
    {
      "id": "journey-to-the-fuel-shrine",
      "title": "Journey to the Fuel Shrine",
      "description": "Reach the closest roadside shrine, fulfill the demands of the fuel gods, and leave with your chariot full but your wallet empty"
    }
  ],
